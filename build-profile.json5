{
  "app": {
    "signingConfigs": [],
    "products": [
      {
        "name": "default",
        // HarmonyOS 7.0.0 / API 26（本机 SDK: apiVersion 26, platformVersion 26.0.0）
        // API >= 26.0.0 时 modelVersion 必须 >= 6.0.0，此时版本串用字符串形式
        "targetSdkVersion": "26.0.0",
        "compatibleSdkVersion": "26.0.0",
        "runtimeOS": "HarmonyOS",
        "buildOption": {
          "strictMode": {
            "caseSensitiveCheck": true,
            "useNormalizedOHMUrl": true
          }
        }
      }
    ],
    "buildModeSet": [
      {
        "name": "debug"
      },
      {
        "name": "release"
      }
    ]
  },
  "modules": [
    {
      "name": "entry",
      "srcPath": "./entry",
      "targets": [
        {
          "name": "default",
          "applyToProducts": [
            "default"
          ]
        }
      ]
    }
  ]
}