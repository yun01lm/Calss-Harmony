{
  "app": {
    "bundleName": "com.calss.jiankebiao",
    "vendor": "calss",
    // 为什么是 1000002：1000000（0.1.0）被自检判「字体」不通过；1000001（0.1.1）修完
    // 字号/转场/滑动，但审核又退回三条（导入没法测、PDF 解析器没就绪、PDF 没有可读文本，
    // 见 docs/ACCEPTANCE.md §6.15）。修完需要重新上传，而应用市场按 versionCode 去重 ——
    // 不升号会被"该版本已存在"挡回来。
    "versionCode": 1000002,
    "versionName": "0.1.2",
    "icon": "$media:layered_image",
    "label": "$string:app_name"
  }
}
